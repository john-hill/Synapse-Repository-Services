{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"path": {
			"type": "string"
		},
		"size": {
			"type": "string",
			"enum": [
				"small",
				"medium",
				"large"
			]
		},
		"name": {
			"type": "string"
		},
		"id": {
			"type": "integer"
		}
	},
	"required": [
		"path",
		"size",
		"name",
		"id"
	]
}
